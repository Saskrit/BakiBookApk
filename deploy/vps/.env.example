# Public URLs (no trailing slash)
# Frontend (web app, verify links in email)
CLIENT_URL=https://bakibook.run.place
# API backend
SERVER_URL=https://api.bakibook.run.place

# Cloudinary (optional but recommended for profile/shop images)
# Must be in the format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Firebase Cloud Messaging (closed-app push)
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
# Place the JSON on the VPS as server/firebase-service-account.json OR set the path:
FIREBASE_SERVICE_ACCOUNT_PATH=/home/ubuntu/bakibook/server/firebase-service-account.json
# Or paste the whole JSON (single line) as:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
